# Application Branding & Header
VITE_APP_TITLE=Minimal Blogs

# Footer text
VITE_APP_FOOTER=Minimal Blogs, create with ❤️ by VeMines

# Base URL for Blog Data (Leave empty for standard relative / local hosting)
VITE_DATA_BASE_URL=https://cdn.jsdelivr.net/gh/vemines/configs@main/blogs/my-blogs

# Storage / Image CDN URL
VITE_R2_PUBLIC_URL=https://cdn.jsdelivr.net/gh/vemines/configs@main/images/my-blogs

