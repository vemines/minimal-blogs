{
  "name": "minimal-blogs",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:helpdesk": "vite --mode helpdesk",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:helpdesk": "tsc -b && vite build --mode helpdesk",
    "build:demo": "tsc -b && vite build --mode demo",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate": "node scripts/generate-posts.js",
    "tags": "node scripts/generate-tags.js",
    "compress": "node scripts/compress-data.js",
    "data": "node scripts/generate-posts.js && node scripts/generate-tags.js && node scripts/compress-data.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}