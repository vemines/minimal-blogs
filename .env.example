# ==============================================================================
# MINIMAL BLOG - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Base URL for Blog Data (posts.txt, tags.json, pinned.txt, posts/*.md)
# - Leave EMPTY ("") for local development (reads from public/ folder) or same-origin hosting
# - Set to GitHub CDN / jsDelivr CDN / Cloudflare Pages URL when content is hosted separately:
#   Example (jsDelivr CDN - recommended for GitHub repos, supports CORS & Edge caching):
#   VITE_DATA_BASE_URL=https://cdn.jsdelivr.net/gh/<username>/<repo>@main/
VITE_DATA_BASE_URL=

# 2. Cloudflare R2 / Storage Public URL (optional, for external image hosting)
# - Leave EMPTY ("") for relative local images (/images/...)
VITE_R2_PUBLIC_URL=
