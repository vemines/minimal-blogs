# ==============================================================================
# MINIMAL BLOG - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Base URL for Blog Data (posts.txt, tags.json, pinned.txt, posts/*.md)
# - Leave EMPTY ("") for local development and GitHub Pages (automatically detected!)
# - Only set this if you host data externally (e.g. jsDelivr CDN, Cloudflare R2, separate CDN):
#   Example (jsDelivr CDN - supports CORS & Edge caching):
#   VITE_DATA_BASE_URL=https://cdn.jsdelivr.net/gh/<username>/<repo>@main/public
VITE_DATA_BASE_URL=

# 2. Cloudflare R2 / Storage Public URL (optional, for external image hosting)
# - Leave EMPTY ("") for relative local images (/images/...)
VITE_R2_PUBLIC_URL=
